# Normalize all text files to LF in the repo
* text=auto eol=lf

# Explicitly declare common text files
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.env   text eol=lf
*.sql   text eol=lf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.ico   binary
*.pkl   binary
*.db    binary
