# ──────────────────────────────────────────────────────────────────────────────
# ROOT .env.example — Docker Compose infrastructure ONLY
#
# Copy to .env and fill in. These vars create the local Postgres CONTAINER via
# docker-compose ${...} substitution. They are NOT app config and NOT used in
# production. All application config lives in  backend/.env.example.
# ──────────────────────────────────────────────────────────────────────────────

# ── Postgres container credentials (consumed by docker-compose.yml) ──────────
POSTGRES_DB_USER=
POSTGRES_DB_PASSWORD=
POSTGRES_DB_NAME=
