# ──────────────────────────────────────────────────────────────────────────────
# ROOT .env.example — Docker Compose infrastructure ONLY
#
# Copy to .env and fill in. These vars are consumed by docker-compose ${...}
# substitution — they configure the CONTAINERS, not the application. All
# application config lives in  backend/.env.example  (and, for the server-side
# deltas, backend/.env.production.example).
#
# Split by which compose file reads them:
#   docker-compose.yml       (dev)  — POSTGRES_DB_* only
#   docker-compose.prod.yml  (prod) — POSTGRES_DB_* + everything below it
#
# EVERY prod knob has a safe built-in default in docker-compose.prod.yml. Leaving
# a line here EMPTY is a valid, working deployment on both targets: compose's
# ${VAR:-default} treats empty exactly like unset. Fill one in only to override.
# See DEPLOYMENT.md for the per-target matrix.
# ──────────────────────────────────────────────────────────────────────────────

# ── Postgres container credentials (both compose files) ──────────────────────
POSTGRES_DB_USER=
POSTGRES_DB_PASSWORD=
POSTGRES_DB_NAME=


# ══════════════════════════════════════════════════════════════════════════════
# PROD-ONLY (docker-compose.prod.yml). Defaults in brackets.
# ══════════════════════════════════════════════════════════════════════════════

# ── Network exposure — THE key per-target difference ─────────────────────────
#
# API_BIND_HOST is the HOST interface the API port is published on. It is NOT
# application config (the app always listens on 0.0.0.0 INSIDE its container);
# it is the Docker port-publish address, which is why it lives here and not in
# app/config.py.
#
#   [127.0.0.1]  DEFAULT, and the correct value for any host with a PUBLIC IP
#                (Oracle Cloud, Hetzner, any VPS). Loopback only — nothing is
#                served to any network. Reach it over an SSH tunnel:
#                    ssh -L 8000:127.0.0.1:8000 <user>@<host>
#                There is no authentication on this API yet, and Docker's
#                iptables rules bypass ufw/firewalld, so a published port is
#                genuinely reachable from the internet regardless of the host
#                firewall.
#
#   0.0.0.0      Acceptable ONLY on a trusted home LAN behind NAT with no
#                port-forward (Raspberry Pi 400 on a home router). This is what
#                lets another device browse
#                    http://<pi-hostname>.local:8000/api/v1/shadow/performance
#                If that Pi ever gets a port-forward or a public IP, set this
#                back to 127.0.0.1 FIRST.
#
# Set it to a single LAN interface (e.g. 192.168.1.50) if you want LAN access
# without listening on every interface.
API_BIND_HOST=

# Host port to publish on, if 8000 is already taken. [8000]
API_PORT=

# ── Database port publish — for SSH-tunnelled GUI clients (DBeaver, psql) ─────
#
# [127.0.0.1] DEFAULT, and the ONLY value you should ever use. Loopback means
#             "this machine only": not the internet, not the LAN. A GUI client
#             reaches it through an SSH tunnel, which already requires the host's
#             private key — no new door, just the existing one reused:
#                 ssh -L 5432:127.0.0.1:5432 <user>@<host>
#             DBeaver has this built in under its SSH tab.
#
# ⚠️  NEVER 0.0.0.0. That publishes Postgres to every network the host is on, and
#     on a public-IP target that means the open internet. Docker inserts its
#     DOCKER-USER iptables rules AHEAD of ufw/firewalld, so an enabled firewall
#     does NOT protect a published port. There is no legitimate reason to change
#     this value.
DB_BIND_HOST=

# Host port for the database publish, if 5432 is already taken locally. [5432]
DB_PORT=


# ── Container resource caps (blast radius, not tuning) ───────────────────────
#
# Defaults are sized for the SMALLEST target (4 GB Pi): backend 1200m + db 768m
# leaves ~2 GB for the OS and the page cache. On a 12 GB Oracle A1 you can raise
# both, but the app does not need it for steady-state observation.
#
# RASPBERRY PI OS WARNING: memory limits are silently IGNORED unless cgroup
# memory is enabled on the kernel command line. DEPLOYMENT.md has the fix and
# the check — an ignored limit means the host OOM killer decides what dies.
# Defaults: 1200m / 384m / 2.0
BACKEND_MEM_LIMIT=
BACKEND_MEM_RESERVATION=
BACKEND_CPUS=
# Defaults: 768m / 256m / 2.0
DB_MEM_LIMIT=
DB_MEM_RESERVATION=
DB_CPUS=


# ── Postgres tuning (defaults sized for the 4 GB Pi) ─────────────────────────
#
# Postgres cannot see its cgroup limit, so these are sized against DB_MEM_LIMIT
# above, not host RAM. Raise shared_buffers/effective_cache_size together if you
# raise DB_MEM_LIMIT.
# Defaults: 256MB / 512MB / 8MB / 64MB / 30 / 1.1 (flash) / 128mb
PG_SHARED_BUFFERS=
PG_EFFECTIVE_CACHE_SIZE=
PG_WORK_MEM=
PG_MAINTENANCE_WORK_MEM=
PG_MAX_CONNECTIONS=
PG_RANDOM_PAGE_COST=
PG_SHM_SIZE=

# Flash-endurance settings. wal_compression + a longer checkpoint interval cut
# WAL write volume (full-page images), which is what wears a microSD card. Both
# are crash-safe: only recovery time grows.
# Defaults: on / 15min / 1GB
PG_WAL_COMPRESSION=
PG_CHECKPOINT_TIMEOUT=
PG_MAX_WAL_SIZE=

# synchronous_commit=off cuts fsync frequency further (another real SD-endurance
# win). It risks losing the last ~200ms of COMMITTED transactions on an unclean
# power loss — it does NOT risk corruption. Defaults to `on`; set `off` only if
# you accept losing at most a few seconds of shadow observations on a power cut.
# Default: on
PG_SYNCHRONOUS_COMMIT=

# How long compose waits for Postgres to become queryable before failing the
# backend's dependency gate. Booting from microSD is slow. [60s]
DB_HEALTH_START_PERIOD=
